<% layout("./layouts/boilerplate") -%>
<div class="row">
 <div class="col-8 offset-2 mt-3">
    <h3>Create New Listing</h3>
    <form action="/listings" method="post">
     <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control">
     </div>
     <div class="mb-3">
        <label for="description" class="form-label">Description:</label>
        <textarea name="listing[description]" type="text" class="form-control"></textarea>
     </div>   
     <div class="mb-3">
        <label for="image" class="form-label">Image Link:</label>
        <input name="listing[img]" placeholder="Enter Image URL/Link:" type="text" class="form-control">
     </div>
     
     <div class="row">
       <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Price:</label>
        <input name="listing[price]" placeholder="1,200" type="number" class="form-control">
       </div>  
       <div class="mb-3 col-md-8">
        <label for="location" class="form-label">Location:</label>
        <input name="listing[location]" placeholder="Aspen" type="text" class="form-control">
       </div>
       
     </div>
     <div class="mb-3">
        <label for="country" class="form-label">Country:</label>
        <input name="listing[country]" placeholder="United State" type="text" class="form-control">
     </div>
        <button type="submit" class="btn btn-dark add-btn mt-3">List</button>
     <br><br>   
    </form>
 </div>
</div>